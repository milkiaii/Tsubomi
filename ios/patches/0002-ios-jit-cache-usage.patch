+size_t AddressSpace::TotalCodeCacheUsedSize() {
+    return total_code_cache_used.load(std::memory_order_relaxed);
+}
+
+void AddressSpace::UpdateCodeCacheUsed() {
+    const size_t used = static_cast<size_t>(code.offset() - prelude_info.end_of_prelude);
+    const size_t previous = accounted_code_cache_used.exchange(used, std::memory_order_relaxed);
+    if (used > previous)
+        total_code_cache_used.fetch_add(used - previous, std::memory_order_relaxed);
+    else
+        total_code_cache_used.fetch_sub(previous - used, std::memory_order_relaxed);
+}
 
